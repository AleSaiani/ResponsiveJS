{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "noEmit": true,
        "paths": {
            "@responsivejs/core": ["./packages/core/src/index.ts"],
            "@responsivejs/core/*": ["./packages/core/src/*.ts"],
            "@responsivejs/runtime": ["./packages/runtime/src/index.ts"],
            "@responsivejs/runtime/*": ["./packages/runtime/src/*.ts"],
            "@responsivejs/contract": ["./packages/contract/src/index.ts"],
            "@responsivejs/contract/*": ["./packages/contract/src/*.ts"],
            "@responsivejs/design": ["./packages/design/src/index.ts"]
        }
    },
    "include": [
        "packages/*/src/**/*",
        "packages/*/tests/**/*",
        "vitest.config.ts",
        "eslint.config.mjs"
    ]
}
