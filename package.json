{
    "name": "responsivejs-workspace",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.18.3",
    "engines": {
        "node": ">=20.19"
    },
    "scripts": {
        "build": "pnpm -r run build",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc -p tsconfig.json",
        "lint": "eslint .",
        "format": "prettier --write \"packages/*/{src,tests}/**/*.ts\" \"*.{md,json,ts,mjs}\"",
        "changeset": "changeset",
        "version": "changeset version",
        "release": "pnpm build && changeset publish",
        "publish:local": "pnpm build && pnpm -r publish --registry http://localhost:4873 --no-git-checks --force"
    },
    "devDependencies": {
        "@changesets/changelog-github": "^0.5.1",
        "@changesets/cli": "^2.29.0",
        "@eslint/js": "^10.0.0",
        "@types/node": "^26.1.1",
        "eslint": "^10.4.0",
        "globals": "^17.0.0",
        "prettier": "^3.8.0",
        "publint": "^0.3.0",
        "typescript": "^5.7.0",
        "typescript-eslint": "^8.60.0",
        "vitest": "^4.1.0"
    }
}
