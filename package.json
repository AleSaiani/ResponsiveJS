{
    "name": "responsivejs-workspace",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.18.3",
    "engines": {
        "node": ">=20.19"
    },
    "scripts": {
        "build": "pnpm -r run build",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "vitest run --config vitest.e2e.config.ts",
        "typecheck": "tsc -p tsconfig.json",
        "lint": "eslint .",
        "format": "prettier --write \"packages/*/{src,tests}/**/*.ts\" \"*.{md,json,ts,mjs}\"",
        "changeset": "changeset",
        "version": "changeset version",
        "release": "pnpm build && changeset publish",
        "publish:local": "pnpm build && node scripts/publish-local.mjs"
    },
    "devDependencies": {
        "@changesets/changelog-github": "^0.5.1",
        "@changesets/cli": "^2.29.0",
        "@eslint/js": "^10.0.0",
        "@types/node": "^26.3.0",
        "eslint": "^10.9.1",
        "globals": "^17.11.0",
        "happy-dom": "^20.11.6",
        "prettier": "^3.8.0",
        "publint": "^0.3.24",
        "typescript": "^5.7.0",
        "typescript-eslint": "^8.68.0",
        "vitest": "^4.1.11"
    }
}
