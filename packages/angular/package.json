{
    "name": "@responsivejs/angular",
    "version": "0.0.0",
    "description": "Angular bindings for r$ — inject-style helpers that own the construct lifecycle: apply on create, update on change, dispose on destroy.",
    "license": "MPL-2.0",
    "type": "module",
    "sideEffects": false,
    "engines": {
        "node": ">=20.19"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@responsivejs/runtime": "workspace:^"
    },
    "peerDependencies": {
        "@angular/core": ">=16"
    },
    "devDependencies": {
        "@angular/core": "^20.0.0",
        "typescript": "^5.7.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/AleSaiani/ResponsiveJS.git",
        "directory": "packages/angular"
    },
    "homepage": "https://github.com/AleSaiani/ResponsiveJS#readme",
    "bugs": {
        "url": "https://github.com/AleSaiani/ResponsiveJS/issues"
    },
    "keywords": [
        "responsive",
        "angular",
        "signals",
        "fluid",
        "container-queries"
    ]
}
