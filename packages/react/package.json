{
    "name": "@responsivejs/react",
    "version": "0.0.0",
    "description": "React bindings for r$ — hooks that own the construct lifecycle: apply on mount, update on change, dispose on unmount.",
    "license": "MPL-2.0",
    "type": "module",
    "sideEffects": false,
    "engines": {
        "node": ">=20.19"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@responsivejs/runtime": "workspace:^"
    },
    "peerDependencies": {
        "react": ">=18"
    },
    "devDependencies": {
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "typescript": "^5.7.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/AleSaiani/ResponsiveJS.git",
        "directory": "packages/react"
    },
    "homepage": "https://github.com/AleSaiani/ResponsiveJS#readme",
    "bugs": {
        "url": "https://github.com/AleSaiani/ResponsiveJS/issues"
    },
    "keywords": [
        "responsive",
        "react",
        "hooks",
        "fluid",
        "container-queries"
    ]
}
